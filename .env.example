# Generate a local environment using npm run setup:local. Do not use development credentials in production.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://freightnaut_app:REPLACE@127.0.0.1:55432/freightnaut
MIGRATION_DATABASE_URL=postgres://freightnaut_owner:REPLACE@127.0.0.1:55432/freightnaut
APP_DATABASE_ROLE=freightnaut_app
DB_SSL=false
REQUIRE_ADMIN_MFA=true
OIDC_PROVIDERS=[{"id":"local","name":"Workspace sign-in","issuer":"http://127.0.0.1:8080/realms/freightnaut","clientId":"freightnaut-web","clientSecret":"REPLACE"}]
SESSION_TTL_SECONDS=28800
SESSION_IDLE_SECONDS=1800
INVITATION_TTL_HOURS=48
PDF_CONCURRENCY=2
PDF_TIMEOUT_MS=30000
REDIS_URL=redis://:REPLACE@127.0.0.1:56379
PDF_QUEUE_NAME=freightnaut-pdf

# Loopback development only. Rejected in production.
LOCAL_SELF_SERVICE_SIGNUP=false
